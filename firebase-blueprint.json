{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with language, theme, and RTL preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "preferredLanguage": {
          "type": "string",
          "description": "Language code (e.g., en, ar, he, fa, ur)",
          "maxLength": 10
        },
        "isRTL": {
          "type": "boolean",
          "description": "Whether RTL layout is enabled"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "KnowledgeDocument": {
      "title": "KnowledgeDocument",
      "description": "Uploaded PDF, Word document, or URL knowledge source",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique document identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Document filename or URL title",
          "maxLength": 256
        },
        "type": {
          "type": "string",
          "enum": ["pdf", "docx", "doc", "url", "text"],
          "description": "Type of document"
        },
        "content": {
          "type": "string",
          "description": "Extracted text content or URL target",
          "maxLength": 500000
        },
        "fileSize": {
          "type": "number",
          "description": "File size in bytes"
        },
        "wordCount": {
          "type": "number",
          "description": "Total word count"
        },
        "pageCount": {
          "type": "number",
          "description": "Number of pages if applicable"
        },
        "isRTL": {
          "type": "boolean",
          "description": "Whether content is RTL detected"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Upload timestamp"
        }
      },
      "required": ["id", "userId", "title", "type", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat message item in a conversation session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User UID who owns the chat",
          "maxLength": 128
        },
        "sender": {
          "type": "string",
          "enum": ["user", "model", "system"],
          "description": "Sender of the message"
        },
        "text": {
          "type": "string",
          "description": "The textual body of the message",
          "maxLength": 100000
        },
        "isRTL": {
          "type": "boolean",
          "description": "Whether the text is detected as RTL"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Message timestamp"
        }
      },
      "required": ["id", "userId", "sender", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records"
    },
    "/users/{userId}/documents/{documentId}": {
      "schema": "KnowledgeDocument",
      "description": "User knowledge base documents and URLs"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "User conversation messages"
    }
  }
}
